<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <!-- Isolated test host uses the existing test-only internals grant. Never load into Dalamud. -->
    <AssemblyName>Mahjong.Plugin.CN.Gameplay.Tests</AssemblyName>
    <DalamudLibPath Condition="'$(DalamudLibPath)'==''">$(APPDATA)/XIVLauncherCN/addon/Hooks/26-09-25-01</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Mahjong.Plugin.CN/Mahjong.Plugin.CN.csproj" />
    <Reference Include="Dalamud;Dalamud.Bindings.ImGui;Lumina;FFXIVClientStructs;InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)/%(Identity).dll</HintPath><Private>true</Private>
    </Reference>
    <None Include="$(DalamudLibPath)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
